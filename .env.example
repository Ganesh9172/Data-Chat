# Firebird AI Configuration

# AI Provider API Key (e.g., OpenAI sk-..., OpenRouter, Groq, or Google Gemini)
AI_API_KEY=your_api_key_here

# AI Model for generation
AI_MODEL=gpt-4o-mini

# Embedding Model for vector indexing
EMBEDDING_MODEL=text-embedding-3-small

# Optional API Base URL (default is OpenAI: https://api.openai.com/v1)
# For OpenRouter: https://openrouter.ai/api/v1
# For Groq: https://api.groq.com/openai/v1
# For Gemini OpenAI-compatible: https://generativelanguage.googleapis.com/v1beta/openai/
# For Ollama: http://localhost:11434/v1
AI_BASE_URL=https://api.openai.com/v1

# Backend Server Port
PORT=8000
HOST=0.0.0.0
