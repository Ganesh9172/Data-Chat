# Firebird AI Configuration

# AI Provider API Key (e.g., Groq, OpenAI sk-..., OpenRouter, or Google Gemini)
AI_API_KEY=your_api_key_here

# AI Model for generation (Groq: openai/gpt-oss-120b)
AI_MODEL=openai/gpt-oss-120b

# Embedding Model for vector indexing (local FastEmbed)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Optional API Base URL (default is Groq: https://api.groq.com/openai/v1)
AI_BASE_URL=https://api.groq.com/openai/v1

# Backend Server Port
PORT=8000
HOST=0.0.0.0

# Admin Authentication & Security
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@firebird.internal
ADMIN_PASSWORD=your_secure_admin_password_here
JWT_SECRET=your_jwt_secret_key_here

# Frontend API URL (for production deployments, e.g., on Render)
VITE_API_URL=https://firebird-bot-y1xh.onrender.com

# YouTube Data API Key (for related video suggestions)
YOUTUBE_API_KEY=your_youtube_api_key_here

